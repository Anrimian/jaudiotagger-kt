  <component name="ChangeListManager">
    <list default="true" id="c6ab1c14-6cd1-42fd-af1f-7ac1a83b7f78" name="Default" comment="Fix ID3v2 zero-size frame parsing and improve MP3 duration calculations&#10;&#10;- Skip zero-size ID3v2 frames in `Id3v2TagReader` instead of terminating tag parsing.&#10;- Update `MpegFrameHeader` to use 576 samples per frame for MPEG-2/2.5 Layer III.&#10;- Improve frame count estimation in `Mp3InfoReader` when Xing/VBRI frame count is zero or missing by inspecting subsequent audio frames.&#10;- Add unit tests for empty ID3v2 frames and MP3 duration calculations, and update `PORTING.md`.">
      <change beforePath="$PROJECT_DIR$/gradle.properties" beforeDir="false" afterPath="$PROJECT_DIR$/gradle.properties" afterDir="false" />
      <change beforePath="$PROJECT_DIR$/jaudiotagger-kt/PORTING.md" beforeDir="false" afterPath="$PROJECT_DIR$/jaudiotagger-kt/PORTING.md" afterDir="false" />
